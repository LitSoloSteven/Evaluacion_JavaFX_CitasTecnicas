# =====================================================================
# Plantilla de configuración local - Sistema de Gestión de Citas
# ---------------------------------------------------------------------
# Instrucciones:
#   1. Copia este archivo y renómbralo a  .env   (mismo directorio raíz)
#   2. Ajusta los valores a tu instalación local de PostgreSQL
#   3. NO subas tu .env al repositorio  (ya está en .gitignore)
# =====================================================================

# URL JDBC de conexión
DB_URL=jdbc:postgresql://localhost:5432/gestion_citas

# Usuario de PostgreSQL
DB_USER=postgres

# Contraseña de PostgreSQL
DB_PASSWORD=postgres

# (Opcional) Puerto si no usas el 5432 por defecto
# DB_PORT=5432