<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.evaluacionpractica.modelocrud.Controllers.CitaTecnicaController"
            prefWidth="1200" prefHeight="740" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #23334b; -fx-accent: #0d9488; -fx-focus-color: #0d9488; -fx-faint-focus-color: #0d948822; -fx-background-color: #f0f5fa;">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="330" minWidth="330" style="-fx-background-color: transparent; -fx-padding: 0;"><content>
        <VBox spacing="9" style="-fx-background-color: linear-gradient(to bottom, #effbf8, #ffffff); -fx-background-radius: 18; -fx-border-color: #cbdfe6; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, #18364b0d, 12, 0.1, 0, 3);">
            <padding>
                <Insets top="22" right="22" bottom="22" left="22"/>
            </padding>
            <Label text="Datos de la cita" style="-fx-text-fill: #125469; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
            <Label text="Programa y organiza cada servicio." wrapText="true" style="-fx-text-fill: #7b8da3; -fx-font-size: 12px; -fx-padding: 0 0 8 0;"/>
            <Label text="Cliente" style="-fx-text-fill: #33465f;"/>
            <ComboBox fx:id="cmbCliente" promptText="Seleccione un cliente" maxWidth="Infinity" style="-fx-background-color: #f7fafc; -fx-border-color: #cbdce7; -fx-border-radius: 7; -fx-background-radius: 7; -fx-pref-height: 36; -fx-prompt-text-fill: #8290a3;"/>
            <Label text="Fecha" style="-fx-text-fill: #33465f;"/>
            <DatePicker fx:id="dpFecha" promptText="dd/MM/aaaa" maxWidth="Infinity" style="-fx-background-color: #f7fafc; -fx-border-color: #cbdce7; -fx-border-radius: 7; -fx-background-radius: 7; -fx-pref-height: 36; -fx-prompt-text-fill: #8290a3;"/>
            <Label text="Hora" style="-fx-text-fill: #33465f;"/>
            <TextField fx:id="txtHora" promptText="HH:mm, ej. 14:30" style="-fx-background-color: #f7fafc; -fx-border-color: #cbdce7; -fx-border-radius: 7; -fx-background-radius: 7; -fx-pref-height: 36; -fx-prompt-text-fill: #8290a3; -fx-padding: 8 10;"/>
            <Label text="Tipo de servicio" style="-fx-text-fill: #33465f;"/>
            <TextField fx:id="txtTipoServicio" promptText="Ej. Mantenimiento preventivo" style="-fx-background-color: #f7fafc; -fx-border-color: #cbdce7; -fx-border-radius: 7; -fx-background-radius: 7; -fx-pref-height: 36; -fx-prompt-text-fill: #8290a3; -fx-padding: 8 10;"/>
            <Label text="Descripción" style="-fx-text-fill: #33465f;"/>
            <TextArea fx:id="txtDescripcion" promptText="Describa el trabajo solicitado"
                      prefRowCount="3" wrapText="true" style="-fx-background-color: #f7fafc; -fx-border-color: #cbdce7; -fx-border-radius: 7; -fx-background-radius: 7; -fx-pref-height: 36; -fx-prompt-text-fill: #8290a3;"/>
            <Label text="Estado" style="-fx-text-fill: #33465f;"/>
            <ComboBox fx:id="cmbEstado" promptText="Seleccione un estado" maxWidth="Infinity" style="-fx-background-color: #f7fafc; -fx-border-color: #cbdce7; -fx-border-radius: 7; -fx-background-radius: 7; -fx-pref-height: 36; -fx-prompt-text-fill: #8290a3;"/>
            <FlowPane hgap="8" vgap="8">
                <padding>
                    <Insets top="10"/>
                </padding>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#onGuardar" prefWidth="130" style="-fx-cursor: hand; -fx-padding: 9 12; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-weight: bold; -fx-graphic-text-gap: 8; -fx-min-height: 38; -fx-effect: dropshadow(gaussian, #0f766e30, 6, 0, 0, 2); -fx-background-color: linear-gradient(to right, #0f766e, #0d9488); -fx-text-fill: white;"><graphic><SVGPath content="M 1 1 H 14 V 15 H 1 Z M 4 1 V 6 H 11 V 1 M 4 15 V 10 H 11 V 15" fill="TRANSPARENT" stroke="#ffffff" strokeWidth="1.6" strokeLineCap="ROUND" strokeLineJoin="ROUND" style="-fx-stroke: #ffffff; -fx-stroke-width: 1.6; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/></graphic></Button>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizar" prefWidth="130" style="-fx-cursor: hand; -fx-padding: 9 12; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-weight: bold; -fx-graphic-text-gap: 8; -fx-min-height: 36; -fx-background-color: #deecfa; -fx-text-fill: #215e91; -fx-border-color: #bbd6ef;"><graphic><SVGPath content="M 2 11 L 1 15 L 5 14 L 15 4 L 12 1 Z M 10 3 L 13 6" fill="TRANSPARENT" stroke="#215e91" strokeWidth="1.6" strokeLineCap="ROUND" strokeLineJoin="ROUND" style="-fx-stroke: #215e91; -fx-stroke-width: 1.6; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/></graphic></Button>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" prefWidth="130" style="-fx-cursor: hand; -fx-padding: 9 12; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-weight: bold; -fx-graphic-text-gap: 8; -fx-min-height: 36; -fx-background-color: #fff1f2; -fx-text-fill: #be123c; -fx-border-color: #fecdd3;"><graphic><SVGPath content="M 2 4 H 14 M 6 4 V 1 H 10 V 4 M 4 4 L 5 15 H 11 L 12 4 M 7 7 V 12 M 9 7 V 12" fill="TRANSPARENT" stroke="#be123c" strokeWidth="1.6" strokeLineCap="ROUND" strokeLineJoin="ROUND" style="-fx-stroke: #be123c; -fx-stroke-width: 1.6; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/></graphic></Button>
                <Button text="Nuevo" onAction="#onLimpiar" prefWidth="130" style="-fx-cursor: hand; -fx-padding: 9 12; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-weight: bold; -fx-graphic-text-gap: 8; -fx-min-height: 36; -fx-background-color: #edf0f7; -fx-text-fill: #4c5d7a; -fx-border-color: #d2daea;"><graphic><SVGPath content="M 8 1 V 15 M 1 8 H 15" fill="TRANSPARENT" stroke="#52647c" strokeWidth="1.6" strokeLineCap="ROUND" strokeLineJoin="ROUND" style="-fx-stroke: #52647c; -fx-stroke-width: 1.6; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/></graphic></Button>
            </FlowPane>
        </VBox>
        </content></ScrollPane>
    </left>
    <center>
        <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #cbdfe6; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, #18364b0d, 12, 0.1, 0, 3); -fx-padding: 22;">
            <BorderPane.margin><Insets left="20"/></BorderPane.margin>
            <Label text="Agenda de servicios" style="-fx-text-fill: #125469; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
            <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
                <Label text="Fecha:" style="-fx-text-fill: #33465f;"/>
                <DatePicker fx:id="dpFiltroFecha" promptText="Todas las fechas" prefWidth="145" style="-fx-background-color: #f7fafc; -fx-border-color: #cbdce7; -fx-border-radius: 7; -fx-background-radius: 7; -fx-pref-height: 36; -fx-prompt-text-fill: #8290a3;"/>
                <Label text="Estado:" style="-fx-text-fill: #33465f;"/>
                <ComboBox fx:id="cmbFiltroEstado" promptText="Todos los estados" prefWidth="140" style="-fx-background-color: #f7fafc; -fx-border-color: #cbdce7; -fx-border-radius: 7; -fx-background-radius: 7; -fx-pref-height: 36; -fx-prompt-text-fill: #8290a3;"/>
                <Button text="Filtrar" onAction="#onFiltrar" style="-fx-cursor: hand; -fx-padding: 9 12; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-weight: bold; -fx-graphic-text-gap: 8; -fx-min-height: 36; -fx-background-color: #dcf4ef; -fx-text-fill: #0f766e; -fx-border-color: #afe1d6;"><graphic><SVGPath content="M 1 2 H 15 L 10 8 V 14 L 6 12 V 8 Z" fill="TRANSPARENT" stroke="#0f766e" strokeWidth="1.6" strokeLineCap="ROUND" strokeLineJoin="ROUND" style="-fx-stroke: #0f766e; -fx-stroke-width: 1.6; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/></graphic></Button>
                <Button text="Limpiar filtros" onAction="#onLimpiarFiltros" style="-fx-cursor: hand; -fx-padding: 9 12; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-weight: bold; -fx-graphic-text-gap: 8; -fx-min-height: 36; -fx-background-color: #f0f5fa; -fx-text-fill: #33465f; -fx-border-color: #dce4ed;"><graphic><SVGPath content="M 3 3 L 13 13 M 13 3 L 3 13" fill="TRANSPARENT" stroke="#52647c" strokeWidth="1.6" strokeLineCap="ROUND" strokeLineJoin="ROUND" style="-fx-stroke: #52647c; -fx-stroke-width: 1.6; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/></graphic></Button>
            </FlowPane>
            <TableView fx:id="tblCitas" fixedCellSize="42" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #cbdce7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0; -fx-base: #e7f0f6; -fx-control-inner-background: #ffffff; -fx-control-inner-background-alt: #f2f8fb; -fx-selection-bar: #c3ede4; -fx-selection-bar-non-focused: #e0f3ee; -fx-selection-bar-text: #123f46;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" maxWidth="70"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="150"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                    <TableColumn fx:id="colHora" text="Hora" prefWidth="60"/>
                    <TableColumn fx:id="colTipoServicio" text="Servicio" prefWidth="140"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="170"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="8"><Label text="Sin citas para mostrar" style="-fx-text-fill: #52647c; -fx-font-size: 16px; -fx-font-weight: bold;"/><Label text="Crea una cita o ajusta los filtros de b&#250;squeda." style="-fx-text-fill: #718096; -fx-font-size: 11px; -fx-padding: 5 0;"/></VBox>
                </placeholder>
            </TableView>
            <Label fx:id="lblTotal" text="Citas mostradas: 0" style="-fx-text-fill: #0f766e; -fx-font-weight: bold; -fx-background-color: #d9f4ec; -fx-background-radius: 6; -fx-padding: 8 12;"/>
        </VBox>
    </center>
</BorderPane>
