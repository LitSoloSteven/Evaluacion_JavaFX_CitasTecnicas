<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.evaluacionpractica.modelocrud.Controllers.ClienteController"
            prefWidth="1000" prefHeight="620">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <left>
        <VBox spacing="8" prefWidth="290" minWidth="290">
            <padding>
                <Insets right="15"/>
            </padding>

            <Label text="Datos del cliente" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Nombres *"/>
            <TextField fx:id="txtNombres" promptText="Ej. Juan Carlos"/>

            <Label text="Apellidos *"/>
            <TextField fx:id="txtApellidos" promptText="Ej. Pérez López"/>

            <Label text="Teléfono *"/>
            <TextField fx:id="txtTelefono" promptText="8 dígitos, ej. 88888888"/>

            <Label text="Correo electrónico *"/>
            <TextField fx:id="txtCorreo" promptText="ejemplo@correo.com"/>

            <CheckBox fx:id="chkActivo" text="Cliente activo" selected="true"/>

            <FlowPane hgap="8" vgap="8">
                <padding>
                    <Insets top="10"/>
                </padding>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#onGuardar" prefWidth="130"/>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizar" prefWidth="130"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" prefWidth="130"/>
                <Button fx:id="btnLimpiar" text="Nuevo / Limpiar" onAction="#onLimpiar" prefWidth="130"/>
            </FlowPane>

            <Label text="* Campos obligatorios" style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label text="Listado de clientes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtBuscar" promptText="Nombres, apellidos o correo..."
                           HBox.hgrow="ALWAYS" onKeyReleased="#onBuscar" onAction="#onBuscar"/>
                <Button text="Buscar" onAction="#onBuscar"/>
                <Button text="Limpiar búsqueda" onAction="#onLimpiarBusqueda"/>
            </HBox>

            <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" maxWidth="70"/>
                    <TableColumn fx:id="colNombres" text="Nombres" prefWidth="150"/>
                    <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="150"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="200"/>
                    <TableColumn fx:id="colActivo" text="Activo" prefWidth="60" maxWidth="80"/>
                </columns>
                <placeholder>
                    <Label text="No hay clientes para mostrar"/>
                </placeholder>
            </TableView>

            <Label fx:id="lblTotal" style="-fx-text-fill: gray;"/>
        </VBox>
    </center>
</BorderPane>
